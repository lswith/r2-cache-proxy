{
  "name": "r2-cache-proxy",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Lazy read-through mirror for any URL-addressed artifact, backed by Cloudflare R2.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lswith/r2-cache-proxy.git"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dead-code": "knip",
    "build": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "@vitest/coverage-istanbul": "^4.1.9",
    "knip": "^6.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.105.0"
  }
}
