{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mirror",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-16",
  "compatibility_flags": ["nodejs_compat"],
  // `logs.invocation_logs` groups every console.log/error emitted during a
  // request into a single timeline in the dashboard (Workers & Pages → this
  // worker → Logs) — the "breadcrumbs" behind an error, at 100% sampling.
  // `upload_source_maps` makes `wrangler deploy` bundle real source maps so
  // exception stack traces in that dashboard resolve back to this TypeScript,
  // not minified/bundled JS.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 }
  },
  "upload_source_maps": true,
  // Custom domain. Cloudflare auto-manages the A/AAAA records on the lswith.io
  // zone on first deploy.
  "routes": [{ "pattern": "bazel-mirror.lswith.io", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Lazy read-through cache of Bazel external deps. Objects are keyed by the
  // upstream URL minus scheme (e.g. `github.com/org/repo/archive/v1.tar.gz`).
  "r2_buckets": [{ "binding": "MIRROR", "bucket_name": "lswith-bazel-mirror" }]
  // Secret (set via `wrangler secret put`): MIRROR_SECRET — the shared token
  // every request must present via HTTP Basic auth (Bazel supplies it from
  // ~/.netrc). Without a valid token the worker returns 401 before doing any
  // R2 or upstream work.
}
